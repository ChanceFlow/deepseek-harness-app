<?xml version="1.0" encoding="utf-8"?>
<!--
  Profile builds keep broad cleartext (the profile manifest's
  android:usesCleartextTraffic="true", documented for a LAN dev host). A
  network security config takes precedence over that flag on Android 7.0+
  (API 24+), so without this build-type override the main config's
  loopback-only policy would also fence profile LAN hosts.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
