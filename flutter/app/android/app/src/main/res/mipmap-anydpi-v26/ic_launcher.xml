<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+): white plate + the dsh favicon glyph
     (black #000 — the dsh web product mark) inside the 66/108 safe zone.
     Older devices fall back to the legacy mipmap-*/ic_launcher.png files.
     Regenerate all ten PNGs with scripts/gen_launcher_icons.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>