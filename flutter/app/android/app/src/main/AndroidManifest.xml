<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The client talks to a plain-http dsh host (e.g. http://10.0.2.2:3080).
         Cleartext stays allowed only for the loopback/emulator routes in
         res/xml/network_security_config.xml; every other host must be HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- On-device speech recognition voice input. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Android 13+ local notifications: the flutter_local_notifications
         plugin (v16+) no longer merges these in, so without them the
         turn-complete/approval/plan notifications never appear. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Network-availability changes drive an immediate reconnect after the
         device's network returns (screen unlock, Wi-Fi/cellular switch). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- The battery-optimization exemption dialog is only exported to callers
         holding this permission; it is the user-facing escape hatch from Doze
         and OEM kill-lists, which a foreground service cannot survive. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Keep-alive foreground service: it holds the mux WebSocket open while
         the app is not visible. specialUse is the type the service actually
         starts with on API 34+ (a persistent user-session connection, so no
         Android 15 dataSync budget applies); dataSync is declared as well
         because specialUse does not exist on the API 29-33 devices that
         still enforce a declared type. The partial wake lock keeps the CPU
         running with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="DSH Mobile"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Keep-alive service, driven from Dart through the dsh/keep_alive
             channel (see DshKeepAliveService.kt). stopWithTask keeps it (and
             its notification) from outliving the task the user dismissed. -->
        <service
            android:name=".DshKeepAliveService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains the persistent connection to the user's own DeepSeek Harness host while agent work is in flight." />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
