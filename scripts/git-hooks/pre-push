#!/usr/bin/env bash
# pre-push — authoritative leak gate on the commit range being pushed.
#
# History was already cleaned by the publish pipeline; this hook only scans
# Requires gitleaks >= 8.18, < 8.30 (8.30.x had a broken staged scan; 8.18.4 verified).
# the NEW commits in this push. Primary engine is Gitleaks:
#   public  (github.com remote / leakscan.mode=public):  gitleaks detect
#           --log-opts=<range> --config scripts/gitleaks.toml
#   secret  (internal repos): built-in default rules (credentials only)
# If gitleaks is not installed, fall back to scripts/scan_leaks.py --commits
# in the same mode (a visible warning is printed).
#
# Override: git config leakscan.mode secret|public|off
# Enable:   git config core.hooksPath scripts/git-hooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

mode=$(git config --get leakscan.mode || true)
if [ -z "$mode" ]; then
  url=$(git remote get-url origin 2>/dev/null || true)
  if [[ "$url" == *github.com* ]]; then
    mode=public
  else
    mode=secret
  fi
fi
[ "$mode" = off ] && exit 0

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$remote_sha" ] && continue

  old="$remote_sha"
  if [ "$old" = "0000000000000000000000000000000000000000" ]; then
    # new branch: scan all commits reachable from local but not from any
    # existing remote ref
    not_in=$(git for-each-ref --format='%(refname)' refs/remotes | sed 's/^/--not /')
    first=$(git rev-list "$local_sha" $not_in | tail -1)
    old="$first"
  fi

  if command -v gitleaks >/dev/null 2>&1; then
    if [ "$mode" = public ]; then
      if [ -f "$ROOT/scripts/gitleaks.toml" ]; then
        gitleaks detect --source "$ROOT" --log-opts="$old..$local_sha" \
          --config "$ROOT/scripts/gitleaks.toml" --no-banner \
          || { echo; echo "pre-push: gitleaks found leaks in $local_ref (public mode)."; echo "  Fix the findings above before pushing."; fail=1; }
      else
        echo "pre-push: WARNING scripts/gitleaks.toml missing — running default rules only"
        gitleaks detect --source "$ROOT" --log-opts="$old..$local_sha" --no-banner \
          || { echo; echo "pre-push: gitleaks found credentials in $local_ref."; echo "  Fix the findings above before pushing."; fail=1; }
      fi
    else
      gitleaks detect --source "$ROOT" --log-opts="$old..$local_sha" --no-banner \
        || { echo; echo "pre-push: gitleaks found credentials in $local_ref."; echo "  Fix the findings above before pushing."; fail=1; }
    fi
  else
    python3 "$ROOT/scripts/scan_leaks.py" --commits="$old..$local_sha" --mode="$mode" \
      || { echo; echo "pre-push: leak scan failed for $local_ref (mode=$mode)."; echo "  Install gitleaks for the authoritative scan."; fail=1; }
  fi
done < /dev/stdin

exit $fail