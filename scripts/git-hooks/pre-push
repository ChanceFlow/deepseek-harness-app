#!/usr/bin/env bash
# pre-push — scan the commit range being pushed for credentials and, when
# pushing to GitHub (public exposure), internal-infrastructure/personal
# signatures. Runs for every pushed ref; a single hit aborts the push.
#
# Mode resolution:
#   - explicit override: git config leakscan.mode (secret|public|off)
#   - otherwise public  if the push destination URL contains "github.com"
#   - otherwise secret
#
# Enable with:  git config core.hooksPath scripts/git-hooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$remote_sha" ] && continue

  url=$(git remote get-url origin 2>/dev/null || true)

  mode=$(git config --get leakscan.mode || true)
  if [ -z "$mode" ]; then
    if [[ "$url" == *github.com* ]]; then
      mode=public
    else
      mode=secret
    fi
  fi
  [ "$mode" = off ] && continue

  old="$remote_sha"
  if [ "$old" = "0000000000000000000000000000000000000000" ]; then
    # new branch: scan all commits reachable from local but not from any
    # existing remote ref
    not_in=$(git for-each-ref --format='%(refname)' refs/remotes | sed 's/^/--not /')
    first=$(git rev-list "$local_sha" $not_in | tail -1)
    range="$first..$local_sha"
  else
    range="$old..$local_sha"
  fi

  if ! python3 "$ROOT/scripts/scan_leaks.py" --commits="$range" --mode="$mode"; then
    echo
    echo "pre-push: leak scan failed for $local_ref (mode=$mode)."
    echo "  Fix the findings above before pushing."
    fail=1
  fi
done < /dev/stdin

exit $fail